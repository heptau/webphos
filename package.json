{
  "name": "webphos",
  "version": "26.0.0",
  "author": "Vilius L.",
  "description": "Online graphics editing tool lets create, edit images using HTML5 technologies.",
  "keywords": [
    "canvas",
    "drawing",
    "paint",
    "layers",
    "effects"
  ],
  "scripts": {
    "server": "webpack serve --mode development --env development --open",
    "dev": "webpack --mode development",
    "build": "webpack --mode production && node scripts/post-build.js",
    "build:analyze": "webpack --mode production --json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "translations:sync": "node scripts/sync-translations.js",
    "lint": "eslint src/js public tests scripts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heptau/webphos"
  },
  "homepage": "https://github.com/heptau/webphos",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.10.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.10.2",
    "source-map-loader": "^5.0.0",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.0",
    "webpack": "^5.90.0",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "alertifyjs": "^1.13.1",
    "blueimp-canvas-to-blob": "^3.29.0",
    "exif-js": "^2.3.0",
    "file-saver": "^2.0.5",
    "fuzzysort": "^2.0.4",
    "gif.js.optimized": "^1.0.1",
    "hermite-resize": "git+https://github.com/viliusle/Hermite-resize.git",
    "jquery": "^3.7.1",
    "pica": "^9.0.1",
    "semver-compare": "^1.0.0",
    "uuid": "^14.0.2",
    "webfontloader": "^1.6.28"
  }
}
